<?xml version="1.0" encoding="UTF-8"?>

<!-- A plain #000000 backdrop. This is nextgen's canvas colour, and the brand
     sits in the chrome instead: the panel's applications menu shows the mark,
     the way the nextgen sidebar header does. There is no logo on the desktop
     for three reasons: a solid frame costs almost nothing in Tight or ZRLE on
     the first frame and on every window move, while any image is repainted
     with it; a clean black desktop keeps bot screenshots clean; and an image
     would need a rasteriser, which the dev host does not have.

     The monitor key is the X connector name, not an index. TigerVNC's Xvnc
     reports the output as VNC-0, so the path is monitorVNC-0. The file this
     replaced used monitor0, which never matched under Xvnc, so its colour
     never applied and the desktop was black by accident, not by design.
     Renaming the TigerVNC output would silently fall back to xfdesktop's
     default; the desktop-backdrop test pins the name, and a TigerVNC bump
     needs a live check.

     There is one backdrop for every workspace. xfdesktop 4.20 runs in
     single-workspace mode and reads workspace0 for all of them unless told
     otherwise, so a workspace1 entry is dead config: it is never drawn. The
     single-workspace-mode and single-workspace-number keys make that
     explicit, and they are what keeps the black on every workspace if
     xfdesktop ever changes its default. image-style 0 is no image,
     color-style 0 is the plain colour, and rgba1 and rgba2 are both opaque
     black. The desktop-icons block stays: it turns every icon class off, so
     the desktop is a workspace to watch, not a place to find files. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="single-workspace-mode" type="bool" value="true"/>
    <property name="single-workspace-number" type="int" value="0"/>
    <property name="screen0" type="empty">
      <property name="monitorVNC-0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="0"/>
          <property name="last-image" type="string" value=""/>
          <property name="image-path" type="string" value=""/>
          <property name="rgba1" type="array">
            <value type="double" value="0"/>
            <value type="double" value="0"/>
            <value type="double" value="0"/>
            <value type="double" value="1"/>
          </property>
          <property name="rgba2" type="array">
            <value type="double" value="0"/>
            <value type="double" value="0"/>
            <value type="double" value="0"/>
            <value type="double" value="1"/>
          </property>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="0"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
    </property>
  </property>
  <property name="last-settings-migration-version" type="uint" value="1"/>
</channel>
