<?xml version="1.0" encoding="UTF-8"?>

<!-- Compositing off: no GPU, no GL, and a compositor over a 24-bit VNC
     framebuffer only costs bandwidth. Two workspaces to match the stock
     default without a workspace-clone surprise.

     The window manager's look is the Teknoir xfwm4 theme, generated by
     tools/gen-xfwm4-theme.py (make theme). The title bar is flat: the focused
     window's title is #141414 against a #000000 unfocused one, so focus reads
     as a change of surface and no colour is spent on chrome. title_alignment
     and button_layout repeat the theme's own values, but they do not decide
     the layout: themerc wins over this channel (measured live: a copy here
     that disagreed with the theme changed nothing). They are here so that
     xfwm4-settings shows what is in effect instead of an old default, and
     the xfwm4-theme test compares the two. There is no menu button (|HMC is
     hide, maximize, close): right-click the title bar or press Alt+Space for
     the window menu.

     Shadows are off. Without a compositor xfwm4 can only fake a drop shadow
     by painting more border, and a 1 px flat frame wants none. The workspace
     names are "1" and "2" so the panel's pager shows two short buttons rather
     than the long "Workspace N" labels. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <property name="workspace_count" type="int" value="2"/>
    <property name="scroll_workspaces" type="bool" value="true"/>
    <property name="wrap_windows" type="bool" value="true"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="theme" type="string" value="Teknoir"/>
    <property name="title_font" type="string" value="Hanken Grotesk SemiBold 10"/>
    <property name="title_alignment" type="string" value="left"/>
    <property name="button_layout" type="string" value="|HMC"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="workspace_names" type="array">
      <value type="string" value="1"/>
      <value type="string" value="2"/>
    </property>
  </property>
</channel>
