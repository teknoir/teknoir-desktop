# Build context for the teknoir-desktop images. The images only need the rootfs
# and rootfs-council trees; everything else is documentation, tests or
# host-side files that would only churn the build cache.

.git
.github
.gitignore
.dockerignore

# Not part of the image
test
deploy
host

# Docs and metadata
*.md
catalog-info.yaml

# Editor / OS noise
.vscode
.idea
*.swp
.DS_Store
